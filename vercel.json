{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/thesis",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": false
    },
    {
      "source": "/subscribe",
      "destination": "/#subscribe",
      "permanent": false
    },
    {
      "source": "/diplomacy",
      "destination": "/entente",
      "permanent": true
    },
    {
      "source": "/diplomacy/:path*",
      "destination": "/entente/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/vote",
      "destination": "https://dipsgiving.brendanwhitaker.com/vote"
    },
    {
      "source": "/vote/:path*",
      "destination": "https://dipsgiving.brendanwhitaker.com/vote/:path*"
    },
    {
      "source": "/entente",
      "destination": "https://diplomacy-steel.vercel.app/entente"
    },
    {
      "source": "/entente/:path*",
      "destination": "https://diplomacy-steel.vercel.app/entente/:path*"
    }
  ]
}
